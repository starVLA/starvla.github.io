---
import '../styles/global.css';
import BiText from '../components/BiText.astro';
import { landingContent } from '../data/landingContent';

interface Props {
  title: string;
  description: string;
  path?: string;
}

const { title, description, path = '/' } = Astro.props;
const siteUrl = 'https://starvla.github.io';
const canonical = `${siteUrl}${path}`;
const ogImage = `${siteUrl}/assets/starvla-overview.webp`;
const { links } = landingContent;
---

<!doctype html>
<html lang="en" data-theme="light" data-locale="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f6f7fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0f1c" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="StarVLA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <title>{title}</title>

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'SoftwareSourceCode',
        name: 'StarVLA',
        description,
        url: siteUrl,
        codeRepository: links.github,
        programmingLanguage: 'Python',
        applicationCategory: 'Robotics, Embodied AI',
        license: links.license,
        citation: links.arxiv,
        author: { '@type': 'Organization', name: 'StarVLA Community', url: 'https://github.com/starVLA' },
      })}
    />

    <script is:inline>
      (() => {
        const storedTheme = localStorage.getItem('starvla-theme') || 'system';
        const storedLocale =
          localStorage.getItem('starvla-locale') ||
          ((navigator.language || '').toLowerCase().startsWith('zh') ? 'zh' : 'en');
        const theme =
          storedTheme === 'system'
            ? window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light'
            : storedTheme;
        const root = document.documentElement;
        root.setAttribute('data-theme', theme);
        root.setAttribute('data-locale', storedLocale);
        root.setAttribute('lang', storedLocale === 'zh' ? 'zh-CN' : 'en');
      })();
    </script>
  </head>
  <body>
    <div class="page-shell">
      <a class="skip-link" href="#main-content">Skip to main content</a>

      <header class="top-nav">
        <div class="container top-nav__inner">
          <a class="brand" href="/">
            <img src="/favicon.svg" alt="" width="28" height="28" />
            <span>StarVLA</span>
          </a>

          <nav class="nav-links" id="navLinks" aria-label="Primary">
            {
              landingContent.nav.map((item) => (
                <a class="nav-link" href={`/#${item.id}`} data-nav={item.id}>
                  <BiText en={item.en} zh={item.zh} />
                </a>
              ))
            }
            <a class="nav-link" href="/contributor">
              <BiText en="Contributors" zh="贡献者" />
            </a>
          </nav>

          <div class="nav-actions">
            <a class="icon-btn" href={links.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
              <i class="ti ti-brand-github" aria-hidden="true"></i>
              <span class="star-count label" id="navStars">★ 3.9k</span>
            </a>
            <button id="localeToggle" class="icon-btn" type="button" aria-label="Toggle language">
              <span data-locale-content="en">中文</span>
              <span data-locale-content="zh">EN</span>
            </button>
            <button id="themeToggle" class="icon-btn" type="button" aria-label="Toggle theme">
              <i class="ti ti-sun" data-theme-icon="light" aria-hidden="true"></i>
              <i class="ti ti-moon" data-theme-icon="dark" aria-hidden="true"></i>
            </button>
            <button id="navToggle" class="icon-btn nav-toggle" type="button" aria-label="Open menu" aria-controls="navLinks">
              <i class="ti ti-menu-2" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      </header>

      <main id="main-content">
        <slot />
      </main>

      <footer class="footer">
        <div class="container footer-row">
          <div>
            <BiText
              en="© 2026 StarVLA Community · Released under the MIT License."
              zh="© 2026 StarVLA 社区 · 基于 MIT 协议发布。"
            />
          </div>
          <div class="footer-links">
            <a href={links.github} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href={links.docs} target="_blank" rel="noopener noreferrer">Docs</a>
            <a href={links.huggingFace} target="_blank" rel="noopener noreferrer">Hugging Face</a>
            <a href={links.arxiv} target="_blank" rel="noopener noreferrer">arXiv</a>
            <a href="/contributor"><BiText en="Contributors" zh="贡献者" /></a>
          </div>
        </div>
      </footer>
    </div>

    <script is:inline define:vars={{ githubApi: links.githubApi }}>
      (() => {
        const html = document.documentElement;
        const localeToggle = document.getElementById('localeToggle');
        const themeToggle = document.getElementById('themeToggle');
        const navToggle = document.getElementById('navToggle');
        const navLinks = document.getElementById('navLinks');
        const navStars = document.getElementById('navStars');

        let themePref = localStorage.getItem('starvla-theme') || 'system';
        const media = window.matchMedia('(prefers-color-scheme: dark)');
        const resolveTheme = (pref) => (pref === 'system' ? (media.matches ? 'dark' : 'light') : pref);

        function applyTheme() {
          const theme = resolveTheme(themePref);
          html.setAttribute('data-theme', theme);
          document.querySelectorAll('[data-theme-icon]').forEach((icon) => {
            icon.style.display = icon.getAttribute('data-theme-icon') === theme ? 'none' : '';
          });
        }

        function setLocale(locale) {
          html.setAttribute('data-locale', locale);
          html.setAttribute('lang', locale === 'zh' ? 'zh-CN' : 'en');
          localStorage.setItem('starvla-locale', locale);
          window.dispatchEvent(new CustomEvent('starvla:locale', { detail: locale }));
        }

        localeToggle?.addEventListener('click', () => {
          setLocale(html.getAttribute('data-locale') === 'zh' ? 'en' : 'zh');
        });
        themeToggle?.addEventListener('click', () => {
          themePref = resolveTheme(themePref) === 'dark' ? 'light' : 'dark';
          localStorage.setItem('starvla-theme', themePref);
          applyTheme();
        });
        media.addEventListener('change', () => themePref === 'system' && applyTheme());
        navToggle?.addEventListener('click', () => navLinks?.classList.toggle('is-open'));
        navLinks?.addEventListener('click', (e) => {
          if (e.target.closest('a')) navLinks.classList.remove('is-open');
        });

        // Reveal-on-scroll.
        const observer = new IntersectionObserver(
          (entries, obs) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
        );
        document.querySelectorAll('.reveal, .bars').forEach((node) => observer.observe(node));

        // Highlight the nav link for the section in view.
        const sections = [...document.querySelectorAll('section[id]')];
        const navMap = new Map([...document.querySelectorAll('[data-nav]')].map((a) => [a.dataset.nav, a]));
        if (sections.length && navMap.size) {
          const spy = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (!entry.isIntersecting) return;
                navMap.forEach((a, id) => a.classList.toggle('is-active', id === entry.target.id));
              });
            },
            { rootMargin: '-40% 0px -55% 0px' }
          );
          sections.forEach((s) => spy.observe(s));
        }

        // Live GitHub numbers (graceful fallback to the baked-in values).
        const compact = (n) => Intl.NumberFormat('en', { notation: 'compact', maximumFractionDigits: 1 }).format(n);
        fetch(githubApi, { headers: { Accept: 'application/vnd.github+json' } })
          .then((r) => (r.ok ? r.json() : null))
          .then((repo) => {
            if (!repo) return;
            if (navStars && repo.stargazers_count) navStars.textContent = `★ ${compact(repo.stargazers_count)}`;
            document.querySelectorAll('[data-live]').forEach((el) => {
              const value = repo[el.getAttribute('data-live')];
              if (typeof value === 'number') el.textContent = compact(value);
            });
          })
          .catch(() => {});

        // Generic copy buttons: data-copy="#selector"
        document.querySelectorAll('[data-copy]').forEach((button) => {
          button.addEventListener('click', async () => {
            const target = document.querySelector(button.getAttribute('data-copy'));
            if (!target) return;
            try {
              await navigator.clipboard.writeText(target.textContent || '');
              button.classList.add('is-copied');
              const label = button.querySelector('[data-copy-label]');
              const original = label?.innerHTML;
              if (label) label.textContent = html.getAttribute('data-locale') === 'zh' ? '已复制' : 'Copied';
              setTimeout(() => {
                button.classList.remove('is-copied');
                if (label && original) label.innerHTML = original;
              }, 1600);
            } catch {}
          });
        });

        setLocale(html.getAttribute('data-locale') || 'en');
        applyTheme();
      })();
    </script>
  </body>
</html>
