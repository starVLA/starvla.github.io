---
import BaseLayout from '../layouts/BaseLayout.astro';
import BiText from '../components/BiText.astro';
import { landingContent as c } from '../data/landingContent';

const maxBar = 100;
const widthOf = (v: number | null) => (v === null ? 0 : (v / maxBar) * 100);
const fmt = (v: number | null) => (v === null ? '–' : `${v.toFixed(1)}%`);
---

<BaseLayout title={c.meta.title} description={c.meta.description}>
  <!-- ============================== HERO ============================== -->
  <section id="overview" class="hero">
    <div class="container hero__grid">
      <div class="reveal is-visible">
        <span class="hero__eyebrow">
          <span class="dot" aria-hidden="true"></span>
          <BiText en={c.hero.eyebrow.en} zh={c.hero.eyebrow.zh} />
        </span>
        <h1 class="hero__title">
          <span class="brand-word">StarVLA</span>
          <BiText en={c.hero.title.en} zh={c.hero.title.zh} />
        </h1>
        <p class="hero__subtitle">
          <BiText en={c.hero.subtitle.en} zh={c.hero.subtitle.zh} />
        </p>
        <div class="cta-row">
          {
            c.hero.ctas.map((cta) => (
              <a
                class={`btn ${cta.primary ? 'btn--primary' : ''}`}
                href={cta.href}
                target="_blank"
                rel="noopener noreferrer"
              >
                <i class={cta.icon} aria-hidden="true" />
                <BiText en={cta.en} zh={cta.zh} />
              </a>
            ))
          }
        </div>
        <div class="hero__install">
          <code id="heroInstall">{c.hero.install}</code>
          <button class="copy-btn" type="button" data-copy="#heroInstall" aria-label="Copy command">
            <i class="ti ti-copy" aria-hidden="true"></i>
            <span data-copy-label><BiText en="Copy" zh="复制" /></span>
          </button>
        </div>
      </div>

      <!-- Lego composer -->
      <aside class="composer reveal is-visible" aria-labelledby="composerTitle">
        <div class="composer__head">
          <h2 class="composer__title" id="composerTitle">
            <BiText en={c.composer.title.en} zh={c.composer.title.zh} />
          </h2>
          <span class="composer__name" id="composerName">StarVLA-OFT</span>
        </div>
        <p class="composer__hint"><BiText en={c.composer.hint.en} zh={c.composer.hint.zh} /></p>

        <div class="composer__layers" id="composer">
          {
            c.composer.layers.map((layer, li) => (
              <div class={`brick brick--${layer.tone}`} data-layer={layer.key}>
                <div class="brick__label">
                  <BiText en={layer.label.en} zh={layer.label.zh} />
                  <small>{String(li + 1).padStart(2, '0')}</small>
                </div>
                <div class="brick__options" role="group">
                  {layer.options.map((opt, oi) => (
                    <button
                      class={`chip ${oi === (layer.key === 'head' ? 1 : 0) ? 'is-active' : ''}`}
                      type="button"
                      data-option={opt.key}
                    >
                      {opt.name}
                      {'world' in opt && opt.world && <span class="chip__tag">WM</span>}
                    </button>
                  ))}
                </div>
              </div>
            ))
          }
        </div>

        <div class="composer__output">
          <div class="composer__output-head">
            <span>configs/my_vla.yaml</span>
            <button class="copy-btn" type="button" data-copy="#composerCode" aria-label="Copy config">
              <i class="ti ti-copy" aria-hidden="true"></i>
              <span data-copy-label><BiText en="Copy" zh="复制" /></span>
            </button>
          </div>
          <pre class="composer__code" id="composerCode"></pre>
        </div>
        <p class="composer__foot"><BiText en={c.composer.footnote.en} zh={c.composer.footnote.zh} /></p>
      </aside>
    </div>
  </section>

  <!-- ============================== STATS ============================= -->
  <section class="section--tight">
    <div class="container reveal">
      <div class="stats">
        {
          c.stats.map((s) => {
            const Tag = 'href' in s && s.href ? 'a' : 'div';
            return (
              <Tag
                class="stat"
                {...('href' in s && s.href ? { href: s.href, target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <span class="stat__value" {...('live' in s && s.live ? { 'data-live': s.live } : {})}>
                  {s.value}
                </span>
                <span class="stat__label">
                  <BiText en={s.label.en} zh={s.label.zh} />
                </span>
              </Tag>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- =========================== ARCHITECTURE ========================= -->
  <section id="architecture" class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow"><BiText en="Architecture" zh="架构" /></span>
        <h2 class="section-title"><BiText en={c.architecture.title.en} zh={c.architecture.title.zh} /></h2>
        <p class="section-lead"><BiText en={c.architecture.lead.en} zh={c.architecture.lead.zh} /></p>
      </div>

      <div class="layer-grid reveal">
        {
          c.architecture.layers.map((layer) => (
            <article class={`layer-card layer-card--${layer.tone}`}>
              <div class="layer-card__top">
                <span class="layer-card__icon">
                  <i class={layer.icon} aria-hidden="true" />
                </span>
                <span class="layer-card__index">{layer.index}</span>
              </div>
              <h3>
                <BiText en={layer.title.en} zh={layer.title.zh} />
              </h3>
              <p>
                <BiText en={layer.body.en} zh={layer.body.zh} />
              </p>
              <div class="tag-row">
                {layer.chips.map((chip) => (
                  <span class="tag">{chip}</span>
                ))}
              </div>
            </article>
          ))
        }
      </div>

      <div class="figure-grid reveal">
        <figure class="figure">
          <img src={c.architecture.figure.src} alt={c.architecture.figure.alt} loading="lazy" />
          <figcaption><BiText en={c.architecture.figure.caption.en} zh={c.architecture.figure.caption.zh} /></figcaption>
        </figure>
        <div class="figure-col">
          <figure class="figure">
            <img src={c.architecture.variants.src} alt={c.architecture.variants.alt} loading="lazy" />
            <figcaption>
              <BiText en={c.architecture.variants.caption.en} zh={c.architecture.variants.caption.zh} />
            </figcaption>
          </figure>
          <article class="panel principles">
            <h3><BiText en={c.architecture.principles.title.en} zh={c.architecture.principles.title.zh} /></h3>
            <ul class="principle-list">
              {
                c.architecture.principles.items.map((p) => (
                  <li>
                    <span class="principle__icon">
                      <i class={p.icon} aria-hidden="true" />
                    </span>
                    <span>
                      <strong class="principle__title">
                        <BiText en={p.title.en} zh={p.title.zh} />
                      </strong>
                      <span class="principle__body">
                        <BiText en={p.body.en} zh={p.body.zh} />
                      </span>
                    </span>
                  </li>
                ))
              }
            </ul>
          </article>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================= RESEARCH =========================== -->
  <section id="research" class="section section--band">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow"><BiText en="Research" zh="研究" /></span>
        <h2 class="section-title"><BiText en={c.research.title.en} zh={c.research.title.zh} /></h2>
        <p class="section-lead"><BiText en={c.research.lead.en} zh={c.research.lead.zh} /></p>
      </div>

      <div class="paper-grid reveal">
        {
          c.research.papers.map((paper) => (
            <article class={`paper ${'featured' in paper && paper.featured ? 'paper--featured' : ''}`}>
              <span class="paper__tag">
                <BiText en={paper.tag.en} zh={paper.tag.zh} />
              </span>
              <h3>{paper.title}</h3>
              <p class="paper__venue">{paper.venue}</p>
              <p class="paper__summary">
                <BiText en={paper.summary.en} zh={paper.summary.zh} />
              </p>
              <div class="paper__links">
                {paper.links.map((link) => (
                  <a
                    class="pill-link"
                    href={link.href}
                    {...(link.href.startsWith('/') ? {} : { target: '_blank', rel: 'noopener noreferrer' })}
                  >
                    {link.label}
                    <i class="ti ti-arrow-up-right" aria-hidden="true" />
                  </a>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============================ BENCHMARKS ========================== -->
  <section id="benchmarks" class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow"><BiText en="Benchmarks" zh="基准" /></span>
        <h2 class="section-title"><BiText en={c.benchmarks.title.en} zh={c.benchmarks.title.zh} /></h2>
        <p class="section-lead"><BiText en={c.benchmarks.lead.en} zh={c.benchmarks.lead.zh} /></p>
      </div>

      <div class="video-grid reveal">
        {
          c.benchmarks.videos.map((card) => (
            <article class="video-card">
              <div class="video-stage" data-carousel>
                {card.videos.map((src, i) => (
                  <video
                    class={i === 0 ? 'is-active' : ''}
                    muted
                    loop
                    playsinline
                    preload={i === 0 ? 'metadata' : 'none'}
                    aria-label={`${card.title} demo ${i + 1}`}
                  >
                    <source src={src} type="video/mp4" />
                  </video>
                ))}
                <div class="video-dots">
                  {card.videos.map((_, i) => (
                    <button
                      class={`video-dot ${i === 0 ? 'is-active' : ''}`}
                      type="button"
                      data-index={i}
                      aria-label={`Show demo ${i + 1}`}
                    />
                  ))}
                </div>
              </div>
              <div class="video-card__body">
                <h3 class="video-card__title">{card.title}</h3>
                <span class="video-card__metric">
                  <BiText en={card.metric.en} zh={card.metric.zh} />
                </span>
                <span class="video-card__value">{card.value}</span>
                <span class="video-card__src">
                  <a href={card.source} target="_blank" rel="noopener noreferrer">
                    <BiText en="Source" zh="来源" /> ↗
                  </a>
                </span>
              </div>
            </article>
          ))
        }
      </div>

      <div class="compare reveal">
        <article class="panel">
          <h3><BiText en={c.benchmarks.comparison.title.en} zh={c.benchmarks.comparison.title.zh} /></h3>
          <p class="panel__note"><BiText en={c.benchmarks.comparison.note.en} zh={c.benchmarks.comparison.note.zh} /></p>
          <div class="legend">
            <span><i style="background: var(--accent)"></i><BiText en={c.benchmarks.comparison.series[0].label.en} zh={c.benchmarks.comparison.series[0].label.zh} /></span>
            <span><i style="background: color-mix(in srgb, var(--accent) 45%, transparent)"></i><BiText en={c.benchmarks.comparison.series[1].label.en} zh={c.benchmarks.comparison.series[1].label.zh} /></span>
            <span><i style="background: var(--ink-3); opacity: .55"></i>{c.benchmarks.comparison.series[2].label.en}</span>
          </div>
          <div class="bars">
            {
              c.benchmarks.comparison.rows.map((row) => (
                <div class="bar-row">
                  <span class="bar-row__name">{row.benchmark}</span>
                  <div class="bar-row__bars">
                    {(['specialist', 'generalist', 'previous'] as const).map((k) => (
                      <div
                        class={`bar bar--${k} ${row[k] === null ? 'bar--na' : ''}`}
                        style={`--w: ${widthOf(row[k])}%`}
                        title={`${row.benchmark} · ${k}: ${fmt(row[k])}`}
                      >
                        <span />
                        <b>{fmt(row[k])}</b>
                      </div>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
          <p class="panel__foot"><BiText en={c.benchmarks.comparison.footnote.en} zh={c.benchmarks.comparison.footnote.zh} /></p>
        </article>

        <article class="panel">
          <h3><BiText en={c.benchmarks.supported.title.en} zh={c.benchmarks.supported.title.zh} /></h3>
          <p class="panel__note">
            <BiText
              en="Every benchmark ships with a training recipe, a policy-server entry point and an evaluation script."
              zh="每个基准都附带训练配方、策略服务入口与评测脚本。"
            />
          </p>
          <div class="panel__group">
            <span class="panel__group-title"><BiText en="Simulation & real robots" zh="仿真与真机" /></span>
            <div class="bench-list">
              {
                c.benchmarks.supported.items.map((b) => (
                  <span class={`bench ${b.done ? '' : 'bench--todo'}`}>
                    <i class={b.done ? 'ti ti-circle-check-filled' : 'ti ti-circle-dashed'} aria-hidden="true" />
                    {b.name}
                  </span>
                ))
              }
            </div>
            <p class="panel__foot">
              <BiText en="Dashed items are in progress." zh="虚线项为进行中。" />
            </p>
          </div>
          <div class="panel__group">
            <span class="panel__group-title"><BiText en="Robot embodiments" zh="机器人本体" /></span>
            <div class="bench-list">
              {c.benchmarks.supported.embodiments.map((e) => <span class="bench">{e}</span>)}
            </div>
          </div>
          <div class="panel__group">
            <span class="panel__group-title"><BiText en="Reports" zh="报告" /></span>
            <div class="report-list">
              {
                c.benchmarks.supported.reports.map((r) => (
                  <a href={r.href} target="_blank" rel="noopener noreferrer">
                    <i class={r.icon} aria-hidden="true" />
                    <BiText en={r.label.en} zh={r.label.zh} />
                  </a>
                ))
              }
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============================ QUICK START ========================= -->
  <section id="quick-start" class="section section--band">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow"><BiText en="Quick start" zh="快速开始" /></span>
        <h2 class="section-title"><BiText en={c.quickStart.title.en} zh={c.quickStart.title.zh} /></h2>
        <p class="section-lead"><BiText en={c.quickStart.intro.en} zh={c.quickStart.intro.zh} /></p>
      </div>

      <div class="quick reveal">
        <div>
          <div class="seg-row">
            <div class="seg" id="goalControls" role="tablist">
              {
                c.quickStart.goals.map((goal, i) => (
                  <button class={i === 0 ? 'is-active' : ''} type="button" role="tab" data-goal={goal.key}>
                    <BiText en={goal.en} zh={goal.zh} />
                  </button>
                ))
              }
            </div>
            <div class="seg" id="benchmarkControls" role="tablist" hidden>
              {
                c.quickStart.benchmarks.map((b, i) => (
                  <button class={i === 0 ? 'is-active' : ''} type="button" role="tab" data-benchmark={b.key}>
                    {b.en}
                  </button>
                ))
              }
            </div>
          </div>

          <div class="terminal">
            <div class="terminal__head">
              <span class="terminal__dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span id="terminalATitle">Terminal</span>
              <button class="copy-btn" type="button" data-copy="#commandA">
                <i class="ti ti-copy" aria-hidden="true"></i>
                <span data-copy-label><BiText en="Copy" zh="复制" /></span>
              </button>
            </div>
            <pre id="commandA"></pre>
          </div>

          <div class="terminal" id="terminalBCard" hidden>
            <div class="terminal__head">
              <span class="terminal__dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span id="terminalBTitle">Terminal B</span>
              <button class="copy-btn" type="button" data-copy="#commandB">
                <i class="ti ti-copy" aria-hidden="true"></i>
                <span data-copy-label><BiText en="Copy" zh="复制" /></span>
              </button>
            </div>
            <pre id="commandB"></pre>
          </div>
          <p class="quick__note" id="quickNote"></p>
        </div>

        <div class="guide-list">
          {
            c.quickStart.guides.map((g) => (
              <a class="guide" href={g.href} target="_blank" rel="noopener noreferrer">
                <span class="guide__icon">
                  <i class={g.icon} aria-hidden="true" />
                </span>
                <span class="guide__text">
                  <span class="guide__title">
                    <BiText en={g.title.en} zh={g.title.zh} />
                  </span>
                  <span class="guide__desc">
                    <BiText en={g.desc.en} zh={g.desc.zh} />
                  </span>
                </span>
                <i class="ti ti-arrow-up-right arrow" aria-hidden="true" />
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============================= MODEL ZOO ========================== -->
  <section id="model-zoo" class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow"><BiText en="Model zoo" zh="模型库" /></span>
        <h2 class="section-title"><BiText en={c.modelZoo.title.en} zh={c.modelZoo.title.zh} /></h2>
        <p class="section-lead"><BiText en={c.modelZoo.lead.en} zh={c.modelZoo.lead.zh} /></p>
      </div>
      <div class="card-grid card-grid--5 reveal">
        {
          c.modelZoo.items.map((m) => (
            <a class="mini-card" href={m.link} target="_blank" rel="noopener noreferrer">
              <span class="mini-card__kind">
                <BiText en={m.kind.en} zh={m.kind.zh} />
              </span>
              <h3>
                <code>{m.name}</code>
              </h3>
              <p>
                <BiText en={m.desc.en} zh={m.desc.zh} />
              </p>
              <span class="mini-card__ext">Hugging Face ↗</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ======================== NEWS + ECOSYSTEM ======================== -->
  <section id="news" class="section section--band">
    <div class="container two-col">
      <div class="reveal">
        <div class="section-head">
          <span class="eyebrow"><BiText en="News" zh="动态" /></span>
          <h2 class="section-title"><BiText en={c.news.title.en} zh={c.news.title.zh} /></h2>
        </div>
        <ol class="timeline">
          {
            c.news.items.map((n) => (
              <li>
                <time datetime={n.date}>{n.date}</time>
                <a href={n.href} target="_blank" rel="noopener noreferrer">
                  <BiText en={n.en} zh={n.zh} />
                </a>
              </li>
            ))
          }
        </ol>
        <a class="more-link" href={`${c.links.github}#news`} target="_blank" rel="noopener noreferrer">
          <BiText en={c.news.more.en} zh={c.news.more.zh} />
          <i class="ti ti-arrow-right" aria-hidden="true"></i>
        </a>
      </div>

      <div class="reveal">
        <div class="section-head">
          <span class="eyebrow"><BiText en="Ecosystem" zh="生态" /></span>
          <h2 class="section-title"><BiText en={c.ecosystem.title.en} zh={c.ecosystem.title.zh} /></h2>
          <p class="section-lead"><BiText en={c.ecosystem.lead.en} zh={c.ecosystem.lead.zh} /></p>
        </div>
        <div class="card-grid" style="grid-template-columns: repeat(2, minmax(0, 1fr));">
          {
            c.ecosystem.items.map((p) => (
              <a class="mini-card" href={p.link} target="_blank" rel="noopener noreferrer">
                <h3>{p.name}</h3>
                <p>
                  <BiText en={p.desc.en} zh={p.desc.zh} />
                </p>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ========================= COMMUNITY + CITE ======================= -->
  <section id="community" class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow"><BiText en="Community" zh="社区" /></span>
        <h2 class="section-title"><BiText en={c.community.title.en} zh={c.community.title.zh} /></h2>
        <p class="section-lead"><BiText en={c.community.lead.en} zh={c.community.lead.zh} /></p>
      </div>
      <div class="card-grid card-grid--4 reveal">
        {
          c.community.cards.map((card) => (
            <a class="mini-card" href={card.href} target="_blank" rel="noopener noreferrer">
              <span class="mini-card__icon">
                <i class={card.icon} aria-hidden="true" />
              </span>
              <h3>{typeof card.title === 'string' ? card.title : <BiText en={card.title.en} zh={card.title.zh} />}</h3>
              <p>
                <BiText en={card.desc.en} zh={card.desc.zh} />
              </p>
            </a>
          ))
        }
      </div>

      <div class="cite reveal" id="citation" style="margin-top: 64px;">
        <div>
          <span class="eyebrow"><BiText en="Citation" zh="引用" /></span>
          <h2 class="section-title" style="font-size: 28px;"><BiText en={c.citation.title.en} zh={c.citation.title.zh} /></h2>
          <p class="section-lead" style="font-size: 15px;"><BiText en={c.citation.lead.en} zh={c.citation.lead.zh} /></p>
          <div class="cta-row" style="margin-top: 18px;">
            <a class="btn btn--sm" href={c.links.paperPage}><i class="ti ti-file-description" aria-hidden="true"></i><BiText en="Paper page" zh="论文页" /></a>
            <a class="btn btn--sm" href={c.links.arxiv} target="_blank" rel="noopener noreferrer"><i class="ti ti-external-link" aria-hidden="true"></i>arXiv</a>
          </div>
        </div>
        <div class="terminal">
          <div class="terminal__head">
            <span class="terminal__dots" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>starvla.bib</span>
            <button class="copy-btn" type="button" data-copy="#bibtex">
              <i class="ti ti-copy" aria-hidden="true"></i>
              <span data-copy-label><BiText en="Copy BibTeX" zh="复制 BibTeX" /></span>
            </button>
          </div>
          <pre id="bibtex">{c.citation.bibtex}</pre>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ composer: c.composer, quickStart: c.quickStart }}>
    const html = document.documentElement;
    const isZh = () => html.getAttribute('data-locale') === 'zh';
    const esc = (s) => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;');

    /* ---------------- Composer ---------------- */
    const composerRoot = document.getElementById('composer');
    const composerCode = document.getElementById('composerCode');
    const composerName = document.getElementById('composerName');
    const selection = { backbone: 'qwen3vl', head: 'oft', recipe: 'sft', benchmark: 'libero' };
    const optionOf = (layerKey, optKey) =>
      composer.layers.find((l) => l.key === layerKey).options.find((o) => o.key === optKey);

    function renderComposer() {
      const backbone = optionOf('backbone', selection.backbone);
      const head = optionOf('head', selection.head);
      const recipe = optionOf('recipe', selection.recipe);
      const bench = optionOf('benchmark', selection.benchmark);
      const framework = `${backbone.prefix}${head.suffix}`;
      composerName.textContent = `StarVLA-${head.suffix}`;

      const comment = `# ${backbone.name} × ${head.name} × ${recipe.name} → ${bench.name}`;
      const lines = [
        `<span class="c">${esc(comment)}</span>`,
        `<span class="k">framework</span>: <span class="s">${esc(framework)}</span>`,
        `<span class="k">backbone</span>:`,
        `  <span class="k">${backbone.world ? 'world_model' : 'vlm'}</span>: <span class="s">${esc(backbone.id)}</span>`,
        `<span class="k">action_head</span>: <span class="s">${esc(head.suffix.toLowerCase())}</span>  <span class="c"># ${esc(isZh() ? head.desc.zh : head.desc.en)}</span>`,
        `<span class="k">recipe</span>: <span class="s">${esc(recipe.id)}</span>`,
        `<span class="k">benchmark</span>: <span class="s">${esc(bench.id)}</span>`,
        '',
        `<span class="p">$</span> bash examples/${esc(bench.dir)}/train_files/run_${esc(bench.id)}_train.sh`,
      ];
      composerCode.innerHTML = lines.join('\n');
    }

    composerRoot?.addEventListener('click', (e) => {
      const chip = e.target.closest('[data-option]');
      if (!chip) return;
      const brick = chip.closest('[data-layer]');
      selection[brick.dataset.layer] = chip.dataset.option;
      brick.querySelectorAll('.chip').forEach((el) => el.classList.toggle('is-active', el === chip));
      renderComposer();
    });

    /* ---------------- Quick start ---------------- */
    const quickNote = document.getElementById('quickNote');
    const commandA = document.getElementById('commandA');
    const commandB = document.getElementById('commandB');
    const terminalATitle = document.getElementById('terminalATitle');
    const terminalBTitle = document.getElementById('terminalBTitle');
    const terminalBCard = document.getElementById('terminalBCard');
    const benchmarkControls = document.getElementById('benchmarkControls');
    const goalButtons = [...document.querySelectorAll('[data-goal]')];
    const benchmarkButtons = [...document.querySelectorAll('[data-benchmark]')];
    let currentGoal = 'install';
    let currentBenchmark = 'libero';

    function renderQuickStart() {
      const zh = isZh();
      const isEval = currentGoal === 'evaluate';
      benchmarkControls.hidden = !isEval;
      terminalBCard.hidden = !isEval;

      if (!isEval) {
        terminalATitle.textContent = zh ? '终端' : 'Terminal';
        commandA.textContent = quickStart.presets[currentGoal].terminalA;
        commandB.textContent = '';
        quickNote.textContent = zh
          ? '提示：请在 starVLA 环境中执行，并按本地路径校正命令。'
          : 'Tip: run inside your starVLA environment and adjust paths to your setup.';
        return;
      }
      const cmd = quickStart.presets.evaluate.mapping[currentBenchmark];
      terminalATitle.textContent = zh ? '终端 A · 策略服务' : 'Terminal A · policy server';
      terminalBTitle.textContent = zh ? '终端 B · 仿真环境' : 'Terminal B · simulator';
      commandA.textContent = cmd.terminalA;
      commandB.textContent = cmd.terminalB;
      quickNote.textContent = zh
        ? '评测使用两个终端与独立依赖环境；请显式设置 checkpoint 路径与环境变量。'
        : 'Evaluation uses two terminals with separate dependencies. Keep checkpoint paths and env variables explicit.';
    }

    goalButtons.forEach((button) =>
      button.addEventListener('click', () => {
        currentGoal = button.dataset.goal;
        goalButtons.forEach((b) => b.classList.toggle('is-active', b === button));
        renderQuickStart();
      })
    );
    benchmarkButtons.forEach((button) =>
      button.addEventListener('click', () => {
        currentBenchmark = button.dataset.benchmark;
        benchmarkButtons.forEach((b) => b.classList.toggle('is-active', b === button));
        renderQuickStart();
      })
    );

    /* ---------------- Video carousels ---------------- */
    document.querySelectorAll('[data-carousel]').forEach((stage) => {
      const videos = [...stage.querySelectorAll('video')];
      const dots = [...stage.querySelectorAll('.video-dot')];
      let index = 0;
      let timer;

      const show = (i) => {
        index = (i + videos.length) % videos.length;
        videos.forEach((v, vi) => {
          const active = vi === index;
          v.classList.toggle('is-active', active);
          if (active) {
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        });
        dots.forEach((d, di) => d.classList.toggle('is-active', di === index));
      };
      const schedule = () => {
        clearInterval(timer);
        timer = setInterval(() => show(index + 1), 6000);
      };
      dots.forEach((dot) =>
        dot.addEventListener('click', () => {
          show(Number(dot.dataset.index));
          schedule();
        })
      );
      // Only play while visible to save bandwidth.
      new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            show(index);
            schedule();
          } else {
            clearInterval(timer);
            videos.forEach((v) => v.pause());
          }
        },
        { threshold: 0.3 }
      ).observe(stage);
    });

    window.addEventListener('starvla:locale', () => {
      renderComposer();
      renderQuickStart();
    });
    renderComposer();
    renderQuickStart();
  </script>
</BaseLayout>
