---
import BiText from './BiText.astro';
import type { BlogPost } from '../data/blogs';

interface Props {
  post: BlogPost;
  variant?: 'featured' | 'compact';
  heading?: 'h2' | 'h3';
  eager?: boolean;
}

const { post, variant = 'featured', heading: Heading = 'h2', eager = false } = Astro.props;
const publishedDate = post.publishedAt ? new Date(`${post.publishedAt}T00:00:00Z`) : null;
const dateOptions: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' };
---

<article class:list={['blog-card', `blog-card--${variant}`]}>
  <a class="blog-card__link" href={post.href}>
    <div class="blog-card__cover">
      <img
        src={post.cover}
        alt={post.coverAlt}
        width="1280"
        height="720"
        loading={eager ? 'eager' : 'lazy'}
        decoding="async"
      />
    </div>
    <div class="blog-card__body">
      <div class="blog-card__meta">
        <span class="blog-card__project">{post.project}</span>
        {
          publishedDate && (
            <time datetime={post.publishedAt}>
              <BiText
                en={publishedDate.toLocaleDateString('en-US', dateOptions)}
                zh={publishedDate.toLocaleDateString('zh-CN', dateOptions)}
              />
            </time>
          )
        }
      </div>
      <Heading class="blog-card__title">
        <BiText en={post.title.en} zh={post.title.zh} />
      </Heading>
      <p class="blog-card__summary">
        <BiText en={post.summary.en} zh={post.summary.zh} />
      </p>
      <div class="blog-card__foot">
        <span class="blog-card__author">
          {post.author}
          <span class="blog-card__language">{post.language === 'en' ? 'English' : '中文'}</span>
        </span>
        <span class="blog-card__read">
          <BiText en="Read article" zh="阅读文章" />
          <span aria-hidden="true">↗</span>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  .blog-card {
    min-width: 0;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    overflow: hidden;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .blog-card:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--line-strong));
    box-shadow: var(--shadow-md);
  }
  .blog-card:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .blog-card__link {
    display: grid;
    grid-template-columns: 0.92fr 1.08fr;
    color: inherit;
    height: 100%;
  }
  .blog-card__link:focus-visible {
    outline: none;
  }
  .blog-card__cover {
    align-self: stretch;
    display: flex;
    align-items: center;
    min-width: 0;
    padding: 24px;
    background: #f1f5fc;
    border-right: 1px solid var(--line);
  }
  .blog-card__cover img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: contain;
  }
  .blog-card__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 36px 38px;
  }
  .blog-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 18px;
    margin-bottom: 16px;
    color: var(--ink-3);
    font-size: 12px;
  }
  .blog-card__project {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
  }
  .blog-card__title {
    margin: 0 0 16px;
    font-size: clamp(24px, 2.25vw, 30px);
    line-height: 1.22;
    font-weight: 650;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }
  .blog-card__summary {
    margin: 0 0 26px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.7;
  }
  .blog-card__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 12px 20px;
    margin-top: auto;
    padding-top: 18px;
    border-top: 1px solid var(--line);
    font-size: 12px;
  }
  .blog-card__author {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--ink-2);
  }
  .blog-card__language {
    color: var(--ink-3);
  }
  .blog-card__language::before {
    content: '·';
    margin-right: 8px;
  }
  .blog-card__read {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--accent);
    font-weight: 600;
  }
  .blog-card__read > span:last-child {
    font-size: 18px;
    line-height: 1;
  }
  .blog-card--compact .blog-card__link {
    grid-template-columns: 1fr;
  }
  .blog-card--compact .blog-card__cover {
    border-right: 0;
    border-bottom: 1px solid var(--line);
  }
  .blog-card--compact .blog-card__body {
    padding: 26px;
  }
  .blog-card--compact .blog-card__title {
    font-size: 24px;
  }
  @media (max-width: 850px) {
    .blog-card__link {
      grid-template-columns: 1fr;
    }
    .blog-card__cover {
      padding: 24px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .blog-card__cover img {
      max-width: 640px;
      margin: 0 auto;
    }
    .blog-card__body {
      padding: 28px;
    }
    .blog-card__title {
      font-size: 26px;
    }
  }
  @media (max-width: 480px) {
    .blog-card__cover {
      padding: 12px;
    }
    .blog-card__body {
      padding: 22px;
    }
    .blog-card__title {
      font-size: 23px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-card {
      transition: none;
    }
  }
</style>
